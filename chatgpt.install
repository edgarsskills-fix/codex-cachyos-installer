post_install() {
    if command -v apparmor_parser >/dev/null 2>&1 &&
        systemctl is-active --quiet apparmor.service; then
        apparmor_parser -r /etc/apparmor.d/chatgpt ||
            printf '%s\n' 'ChatGPT: AppArmor profile could not be loaded; check apparmor.service.' >&2
    fi
}

post_upgrade() {
    post_install
}

pre_remove() {
    if command -v apparmor_parser >/dev/null 2>&1 &&
        systemctl is-active --quiet apparmor.service; then
        apparmor_parser -R /etc/apparmor.d/chatgpt || true
    fi
}
